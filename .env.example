# Copy this file to .env and fill values before running locally

# If Railway provides a single DATABASE_URL, set that instead of individual DB_* values
# For Railway/Postgres plugin: DATABASE_URL=postgres://user:pass@host:port/dbname

# Example (leave blank locally and use Railway secrets in production):
DATABASE_URL=

# Optional individual database settings (only if not using DATABASE_URL)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=

# Server
PORT=5000
NODE_ENV=development

# JWT and other secrets
JWT_SECRET=change_this_to_a_secure_value
NODE_ENV=production
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Use DATABASE_URL on hosted PostgreSQL providers when available.
DATABASE_URL=postgresql://user:password@host:5432/database

# Or use these local PostgreSQL variables instead of DATABASE_URL.
DB_USER=postgres
DB_HOST=localhost
DB_NAME=hospital_db
DB_PASSWORD=replace-with-your-db-password
DB_PORT=5432

ADMIN_USERNAME=Ajok Hanin Ajang
ADMIN_PASSWORD=replace-with-your-admin-password

# Optional: comma-separated allowed frontend origins.
# Leave blank when frontend and backend are hosted together.
CORS_ORIGIN=
